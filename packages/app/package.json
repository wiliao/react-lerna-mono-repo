{
  "name": "@tuomo/app",
  "version": "0.1.0",
  "description": "JavaScript concepts playground",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:no-cache": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ts": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.cjs",
    "lint": "eslint . --ext .js,.mjs,.ts",
    "lint:fix": "eslint . --ext .js,.mjs,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,json,ts}\"",
    "test:unit": "playwright test",
    "test:unit:ui": "playwright test --ui",
    "test:unit:report": "playwright show-report",
    "test:force": "node -e \"const fs=require('fs'); try{fs.rmSync('../../node_modules/.cache',{recursive:true,force:true})}catch(e){}\" && node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache",
    "test:all": "npm test && npm run test:unit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "javascript",
    "practice",
    "concepts"
  ],
  "author": "Will Liao",
  "license": "MIT",
  "dependencies": {
    "@tuomo/common": "0.1.0"
  }
}
