{
  "name": "@tuomo/root",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "lerna run build",
    "dev": "lerna run dev --parallel",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch --parallel",
    "test:coverage": "lerna run test:coverage",
    "test:e2e": "lerna run test:e2e",
    "test:app": "lerna run test --scope=@tuomo/app",
    "test:app:clean": "npm run clean && lerna run test:no-cache --scope=@tuomo/app",
    "lint": "lerna run lint",
    "lint:fix": "lerna run lint:fix",
    "format": "lerna run format",
    "format:check": "lerna run format:check",
    "lerna:list": "lerna list --all",
    "lerna:list:long": "lerna list --all --long",
    "lerna:list:graph": "lerna list --all --graph",
    "lerna:check": "lerna list --all --long && lerna list --all --graph",
    "clean:cache": "rimraf node_modules/.cache packages/app/node_modules/.cache packages/common/node_modules/.cache packages/web/node_modules/.cache",
    "clean:coverage": "rimraf packages/app/coverage packages/common/coverage packages/web/coverage",
    "clean:playwright": "rimraf packages/app/playwright-report packages/app/test-results",
    "clean:eslint": "rimraf packages/app/.eslintcache packages/common/.eslintcache packages/web/.eslintcache",
    "clean": "npm run clean:cache && npm run clean:coverage && npm run clean:playwright && npm run clean:eslint",
    "clean:all": "rimraf node_modules packages/app/node_modules packages/common/node_modules packages/web/node_modules",
    "clean:install": "npm run clean:all && npm install"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "lerna": "^8.2.4",
    "rimraf": "^6.1.2"
  }
}
